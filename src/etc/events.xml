<?xml version="1.0"?>
<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_before">
        <observer
            name="selopez_enforce_product_compliance"
            instance="Selopez\ProductCompliance\Observer\EnforceComplianceOnProductSave"/>
    </event>
    <event name="catalog_product_save_after">
        <observer
            name="selopez_release_product_compliance"
            instance="Selopez\ProductCompliance\Observer\ReleaseComplianceOnProductSave"/>
    </event>
</config>
