<?xml version="1.0"?>
<routes
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/product-compliance/:sku" method="GET">
        <service class="Selopez\ProductCompliance\Api\ComplianceCheckerInterface" method="checkBySku"/>
        <resources><resource ref="Selopez_ProductCompliance::check"/></resources>
    </route>
</routes>
