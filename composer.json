{
    "name": "selopez/product-compliance-demo",
    "description": "Development workspace for the Product Compliance module.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        }
    ],
    "require-dev": {
        "php": "~8.3.0",
        "magento/framework": "103.0.7-p4",
        "magento/module-catalog": "104.0.7-p4",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13",
        "magento/magento-coding-standard": "^35.0"
    },
    "autoload": {
        "psr-4": {
            "Selopez\\ProductCompliance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Selopez\\ProductCompliance\\Test\\": "Test/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=phpcs.xml",
        "test:coverage": "phpunit --coverage-text --coverage-clover build/coverage.xml"
    }
}
